{
  "name": "staff-mcp",
  "version": "2.0.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChineseAStar/staff-mcp.git"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "staff-mcp": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "builtin-profiles",
    "docs/file-manager.md",
    "docs/terminal.md",
    "README.md",
    "README_zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && tsc --project tsconfig.ui.json && node scripts/build-file-manager.mjs",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --test dist/tests/**/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@vscode/ripgrep": "1.18.0",
    "commander": "^15.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "js-yaml": "^5.4.2",
    "undici": "^7.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "codemirror": "6.0.2",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.3.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@codemirror/commands": "6.11.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-css": "6.3.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.27.3",
    "prettier": "3.6.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  }

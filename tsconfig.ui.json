{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["react", "react-dom"]
  },
  "include": [
    "src/file-manager/ui/**/*.ts",
    "src/file-manager/ui/**/*.tsx",
    "src/terminal/ui/**/*.ts",
    "src/terminal/ui/**/*.tsx"
  ]
}
